#!/usr/bin/env bash
#
# extract <archive> — extract most archive formats (and mount .dmg images).
# Converted from a zsh function in holman/dotfiles.
# credit: http://nparikh.org/notes/zshrc.txt

set -e

if [ -z "$1" ]; then
  echo "usage: extract <file>" >&2
  exit 1
fi
if [ ! -f "$1" ]; then
  echo "extract: '$1' is not a valid file" >&2
  exit 1
fi

case "$1" in
  *.tar.bz2)   tar -jxvf "$1" ;;
  *.tar.gz)    tar -zxvf "$1" ;;
  *.tar.xz)    tar -Jxvf "$1" ;;
  *.tar)       tar -xvf  "$1" ;;
  *.tbz2)      tar -jxvf "$1" ;;
  *.tgz)       tar -zxvf "$1" ;;
  *.bz2)       bunzip2   "$1" ;;
  *.gz)        gunzip    "$1" ;;
  *.xz)        unxz      "$1" ;;
  *.zip|*.ZIP) unzip     "$1" ;;
  *.dmg)       hdiutil mount "$1" ;;
  *.Z)         uncompress "$1" ;;
  *.7z)        7z x "$1" ;;
  *.rar)       unrar x "$1" ;;
  *)           echo "extract: don't know how to extract '$1'" >&2; exit 1 ;;
esac
