# Ghostty — managed by chezmoi (home/dot_config/ghostty/config).
# Ghostty config values are literal: NO quotes, value is the rest of the line.

# --- Font -------------------------------------------------------------------
# Operator Mono SSm, with its cursive "Book Italic" wired to italic text.
# Nerd Font icon glyphs fall back to Symbols Nerd Font Mono, so Operator Mono
# stays pristine (no patching). Face names verified via `ghostty +list-fonts`.
font-family = Operator Mono SSm
font-family = Symbols Nerd Font Mono
font-style = Book
font-style-bold = Bold
font-style-italic = Book Italic
font-style-bold-italic = Bold Italic
font-size = 14
font-thicken = true

# --- Theme ------------------------------------------------------------------
theme = TokyoNight Night

# --- Window -----------------------------------------------------------------
window-padding-x = 8
window-padding-y = 8
mouse-hide-while-typing = true

# Send Option as Alt so the zsh word-motion bindings (Alt-b / Alt-f / Opt-←→)
# work.
macos-option-as-alt = true

# --- Cursor -----------------------------------------------------------------
cursor-style = block
cursor-style-blink = false
