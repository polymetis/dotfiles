# Managed by chezmoi (home/dot_gitconfig.tmpl). Name/email come from the
# `chezmoi init` prompts, so this file stays machine-agnostic and secret-free.
#
# Git shortcuts intentionally live as bin/git-* scripts in ~/.local/bin, not as
# [alias] entries — easier to read, test, and run from anywhere.

[user]
	name = {{ .name }}
	email = {{ .email }}

[init]
	defaultBranch = main

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	attributesfile = ~/.gitattributes_global
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true       # n / N to move between diff sections
	line-numbers = true
	true-color = always

[difftool]
	prompt = false        # don't ask "Launch 'delta'?" once per file

[difftool "delta"]
	# `env -u GIT_EXTERNAL_DIFF` is load-bearing, NOT boilerplate. difftool exports
	# GIT_EXTERNAL_DIFF=git-difftool--helper to the tool it launches; delta's
	# two-path mode shells out to `git diff --no-index`, that inner git obeys the
	# inherited variable and re-invokes the helper -> delta -> git -> ... until the
	# machine runs out of processes. Unsetting it for the child breaks the cycle.
	# (delta accepts two directories as well as two files, so `-d` works too.)
	cmd = env -u GIT_EXTERNAL_DIFF delta "$LOCAL" "$REMOTE"

[merge]
	# diff3, NOT zdiff3: zdiff3 needs git >= 2.35, but macOS GUI/launchd apps fall
	# back to Apple's git 2.30, which hard-errors on an unknown conflict style.
	conflictstyle = diff3

[diff]
	tool = delta          # otherwise `git difftool` launches FileMerge.app on macOS
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
	renames = true

[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = false

[fetch]
	prune = true
	pruneTags = true

[rebase]
	autosquash = true
	autostash = true
	updateRefs = true

[rerere]
	enabled = true        # remember conflict resolutions and replay them

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[commit]
	verbose = true        # show the diff in the commit message editor

[color]
	ui = auto

# (no help.autocorrect: the "prompt" value needs git >= 2.34 and Apple's 2.30
# errors on it. Git's default already shows a "did you mean…" suggestion.)

[credential]
	helper = osxkeychain

[hub]
	protocol = ssh
